# Copy to .env and adjust. No API keys — this is a self-hosted model.

# Base model id (HuggingFace) the LoRA adapter was trained on.
BASE_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct

# Path to the saved LoRA adapter directory (from the training notebook).
# Relative to the backend/ working dir. If this dir is missing, the server
# falls back to serving the plain base model so the site still runs.
ADAPTER_PATH=../qwen-lora-adapter

# Default system prompt used when the client doesn't send one.
SYSTEM_PROMPT=You are a helpful assistant for NimbusCloud.

# Hard cap on generated tokens (protects the server from huge requests).
MAX_NEW_TOKENS_CAP=512

# Allowed frontend origins (comma-separated) for CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server bind
HOST=0.0.0.0
PORT=8000
# Set to any value to enable auto-reload in dev (leave empty in prod).
RELOAD=
